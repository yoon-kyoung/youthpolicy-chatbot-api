{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/chat.js": { "maxDuration": 60 },
    "api/moderate.js": { "maxDuration": 30 },
    "api/compare.js": { "maxDuration": 30 }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET,POST,OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type, x-admin-key" },
        { "key": "Access-Control-Expose-Headers", "value": "X-Policy-Ids" }
      ]
    }
  ]
}
